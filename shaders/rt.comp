};

vec3 get_emission(Material m)
{
    return m.emission_color * m.emission_power;
}
vec2 RayDirectionToUV(vec3 raydir) {
    // Step 1: Normalize the Ray Direction
    raydir = normalize(raydir);

    // Step 2: Convert Cartesian Coordinates to Spherical Coordinates
    // Assuming your skybox is centered at (0, 0, 0)
    // Calculate spherical coordinates
    float phi = atan(raydir.z, raydir.x);
    float theta = acos(raydir.y);

    // Step 3: Map Spherical Coordinates to UV Coordinates
    // Convert spherical coordinates to UV coordinates
    float u = (phi + 3.14159265359) / (2.0 * 3.14159265359);
    float v = theta / 3.14159265359;

    return vec2(u, v);
}
// Function to calculate intersection of a ray with a triangle using MllerTrumbore intersection algorithm
float intersectTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, vec3 n0, vec3 n1, vec3 n2, bool hasNormal, out vec3 normal, vec2 uv0, vec2 uv1, vec2 uv2, bool hasTexture, out vec2 interpolatedUv)
{
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(rd, edge2);
    float a = dot(edge1, h);

    if (abs(a) < 0.0001)
        return -1.0;

    float f = 1.0 / a;
    vec3 s = ro - v0;
    float u = f * dot(s, h);

    if (u < 0.0 || u > 1.0)
        return -1.0;

    vec3 q = cross(s, edge1);
    float v = f * dot(rd, q);

    if (v < 0.0 || u + v > 1.0)
        return -1.0;

    float t = f * dot(edge2, q);
    if (t > 1e-7) // ray intersection
    {
        // Compute the face normal
        vec3 faceNormal = normalize(cross(edge1, edge2));
        float w = 1.0 - u - v;

        // Always interpolate UV coordinates if texture data is available
        if (hasTexture)
        {
            interpolatedUv = u * uv1 + v * uv2 + w * uv0;
        }
        else
        {
            interpolatedUv = vec2(0, 0);
        }

        // Always interpolate normals if normal data is available
        if (hasNormal)
        {
            // Interpolate the normal using barycentric coordinates
            normal = normalize(u * n1 + v * n2 + w * n0);
        }
        else
        {
            // Use the face normal if no vertex normals are provided
            normal = faceNormal;
        }

        // Ensure the normal faces opposite to the ray direction
        if (dot(normal, rd) > 0.0)
        {
            normal = -normal;
        }

        return t;
    }
    return -1.0;
}
// Lightweight triangle intersection: only returns t, no normal/uv interpolation
float intersectTriangleSimple(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2)
{
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(rd, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 0.0001)
        return -1.0;
    float f = 1.0 / a;
    vec3 s = ro - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0)
        return -1.0;
    vec3 q = cross(s, edge1);
    float v = f * dot(rd, q);
    if (v < 0.0 || u + v > 1.0)
        return -1.0;
    float t = f * dot(edge2, q);
    if (t > 0.0001)
        return t;
    return -1.0;
}
// Function to calculate the intersection of a ray with a sphere
float get_t(vec3 ray_origin, vec3 ray_dir, vec3 center, float r)
{
    vec3 oc = ray_origin - center;
    float a = dot(ray_dir, ray_dir);
    float b = 2.0 * dot(oc, ray_dir);
    float c = dot(oc, oc) - r * r;
    float d = b * b - 4.0 * a * c;

    if (d < 0.01f)
        return -1.0;

    float sqrt_d = sqrt(d);
    float t1 = (-b - sqrt_d) / (2.0 * a);
    float t2 = (-b + sqrt_d) / (2.0 * a);

    // Return the smallest positive t value
    if (t1 > 0.0)
        return t1;
    if (t2 > 0.0)
        return t2;
    return -1.0;
}
// Update intersectBox to take rayinv as argument
bool intersectBox(vec3 ray_origin, vec3 ray_dir, vec3 rayinv, vec3 min_, vec3 max_, out float tmin, out float tmax) {
    vec3 t0s = (min_ - ray_origin) * rayinv;
    vec3 t1s = (max_ - ray_origin) * rayinv;
    vec3 tSmall = min(t0s, t1s);
    vec3 tLarge = max(t0s, t1s);
    float epsilon = 0.0001;
    tmin = max(max(tSmall.x, tSmall.y), tSmall.z);
    tmax = min(min(tLarge.x, tLarge.y), tLarge.z);
    return tmax >= tmin && tmax > 0.0;
}
// Struct to store intersection information
struct HitInfo
{
    float t;
    int index;
    bool is_sphere;
};

// Function to find the closest sphere/triangle intersection (refactored)
HitInfo find_closest(vec3 ray_origin, vec3 ray_dir, vec3 rayinv, out int intersects) {
    float min_t = 1e30;
    int min_index = -1;
    bool is_sphere = true;
    intersects = 0;
    for (int i = 0; i < sphere_size; ++i) {
        float t = get_t(ray_origin, ray_dir, spheres[i].center, spheres[i].r);
        if (t > 0.0 && t < min_t) {
            min_t = t;
            min_index = i;
            is_sphere = true;
        }
    }
    int stack[32];
    int stack_top = 0;
    float tri_min_t = min_t;
    int tri_min_index = -1;
    if (bvh_size > 0) {
        stack[stack_top++] = 0;
    }
    while (stack_top > 0) {
        int index = stack[--stack_top];
        BVHNode node = bvh[index];
        float tmin, tmax;
        if (!intersectBox(ray_origin, ray_dir, rayinv, node.box.min_, node.box.max_, tmin, tmax) || tmin > tri_min_t) {
            continue;
        }
        bool is_leaf = (node.left == -1 && node.right == -1);
        if (is_leaf) {
            for (int i = node.start; i < node.end; ++i) {
               // int idx = indices[i];
                float t = intersectTriangleSimple(ray_origin, ray_dir, triangle[i].v0, triangle[i].v1, triangle[i].v2);
                intersects++; // triangle test
                if (t > 0.0 && t < tri_min_t) {
                    tri_min_t = t;
                    //tri_min_index = idx;
                    tri_min_index = i;
                }
            }
        } else {
            int left = node.left;
            int right = node.right;
            float tminL, tmaxL;
            float tminR, tmaxR;
            bool hitL = (left != -1) && intersectBox(ray_origin, ray_dir, rayinv, bvh[left].box.min_, bvh[left].box.max_, tminL, tmaxL) && tminL < tri_min_t;
            bool hitR = (right != -1) && intersectBox(ray_origin, ray_dir, rayinv, bvh[right].box.min_, bvh[right].box.max_, tminR, tmaxR) && tminR < tri_min_t;
            intersects += int(hitL) + int(hitR); // bbox tests
            if (hitL && hitR) {
                if (tminL < tminR) {
                    stack[stack_top++] = right;
                    stack[stack_top++] = left;
                } else {
                    stack[stack_top++] = left;
                    stack[stack_top++] = right;
                }
            } else if (hitL) {
                stack[stack_top++] = left;
            } else if (hitR) {
                stack[stack_top++] = right;
            }
        }
    }
    if (tri_min_index != -1 && tri_min_t < min_t) {
        min_t = tri_min_t;
        min_index = tri_min_index;
        is_sphere = false;
    }
    return HitInfo(min_t, min_index, is_sphere);
}
bool debug_box(vec3 ray_origin, vec3 ray_dir, vec3 rayinv) {
    float min_t = 1e20;
    int min_index = -1;
    float tmin, tmax;
    for (int i = 0; i < bvh_size; ++i) {
        vec3 normal;
        bool inter = intersectBox(ray_origin, ray_dir, rayinv, bvh[i].box.min_, bvh[i].box.max_, tmin, tmax);
        if (inter) {
            return true;
        }
    }
    return false;
}
//#define DEBUG_ALL_TRIANGLES 0
void main() {
#ifdef DEBUG_ALL_TRIANGLES
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(iResolution.x) || pix.y >= int(iResolution.y)) return;
    vec2 fragCoord = vec2(pix);
    vec4 coords = vec4(fragCoord, 0.0, 1.0);
    float aspect_ratio = iResolution.x / iResolution.y;
    vec2 ouv = coords.xy / iResolution.xy;
    vec2 uv = ouv;
    uv = 2.0 * (uv - 0.5);
    uv.x *= aspect_ratio;
    float fov_rad = radians(fov);
    float scale = tan(fov_rad * 0.5);
    float scale_x = scale * aspect_ratio;
    mat3 rotY = rotateY(angle_offset.x);
    mat3 rotX = rotateX(angle_offset.y);
    mat3 camera_rotation = rotY * rotX;
    vec3 forward = camera_rotation * vec3(0, 0, 1);
    vec3 right = camera_rotation * vec3(1, 0, 0);
    vec3 up = camera_rotation * vec3(0, 1, 0);
    vec3 ray_origin = camera_pos;
    vec3 ray_dir = normalize(forward + uv.x * scale * right + uv.y * scale * up);
    vec3 jittering = random_vec3() * 0.001;
    ray_dir += jittering;
    ray_dir = normalize(ray_dir);
    float min_t = 1e30;
    int min_index = -1;
    for (int i = 0; i < triangle.length(); ++i) {
        float t = intersectTriangleSimple(ray_origin, ray_dir, triangle[i].v0, triangle[i].v1, triangle[i].v2);
        if (t > 0.0 && t < min_t) {
            min_t = t;
            min_index = i;
        }
    }
    vec3 outCol = vec3(0.0);
    if (min_index != -1) {
        // Flat shade: color by triangle index
        float shade = float((min_index % 32)) / 31.0;
        outCol = vec3(shade, 1.0 - shade, 0.5 + 0.5 * shade);
    } else {
        // Miss: show background
        outCol = vec3(0.0, 0.0, 0.0);
    }
    imageStore(outputImage, pix, vec4(outCol, 1.0));
    return;
#else
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(iResolution.x) || pix.y >= int(iResolution.y)) return;
    vec2 fragCoord = vec2(pix);
    vec4 coords = vec4(fragCoord, 0.0, 1.0);
    initRandomGenerator(coords.xy);
    vec3 dc = vec3(1.0);
    float aspect_ratio = iResolution.x / iResolution.y;
    vec2 ouv = coords.xy / iResolution.xy;
    vec2 uv = ouv;
    uv = 2.0 * (uv - 0.5);
    uv.x *= aspect_ratio;
    int samples = accumulateSamples;
    int bounces = accumulateBounces;
    int max_bounces = accumulateBounces;
    vec3 sky_color = vec3(0.9, 0.8, 0.8);
    vec3 fcolor = vec3(0.0);
    float fov_rad = radians(fov);
    float scale = tan(fov_rad * 0.5);
    float scale_x = scale * aspect_ratio;
    if (iFrame == 1) {
        samples = movingSamples;
        bounces = movingBounces;
    }
    vec3 flight = vec3(0.0);
    for (int s = 0; s < samples; ++s) {
        vec3 ray_origin = camera_pos;
        mat3 rotY = rotateY(angle_offset.x);
        mat3 rotX = rotateX(angle_offset.y);
        mat3 camera_rotation = rotY * rotX;
        vec3 forward = camera_rotation * vec3(0, 0, 1);
        vec3 right = camera_rotation * vec3(1, 0, 0);
        vec3 up = camera_rotation * vec3(0, 1, 0);
        vec3 ray_dir = normalize(forward + uv.x * scale * right + uv.y * scale * up);
        vec3 jittering = random_vec3() * 0.001;
        ray_dir += jittering;
        ray_dir = normalize(ray_dir);
        vec3 rayinv = 1.0 / ray_dir;
        vec3 light = vec3(0.0);
        vec3 contribution = vec3(1.0);
        vec3 bbCol = vec3(0.0f);
        if (bounces == 1) {
            int intersects = 0;
            HitInfo hi = find_closest(ray_origin, ray_dir, rayinv, intersects);
            if (hi.index == -1) {
                vec2 skybox_uv = RayDirectionToUV(ray_dir);
                vec3 sky_box = texture(hdri, skybox_uv).rgb;
                sky_box = clamp(sky_box, 0.0f, 1.0f);
                light = sky_box;
            } else {
                Material mat;
                vec3 hit_point = vec3(0.0f);
                vec3 normal;
                if (hi.is_sphere) {
                    Sphere sh = spheres[hi.index];
                    mat = materials[sh.matIndex];
                    hit_point = ray_origin + ray_dir * hi.t;
                    normal = normalize(hit_point - sh.center);
                } else {
                    Triangle th = triangle[hi.index];
                    mat = materials[th.matIndex];
                    hit_point = ray_origin + ray_dir * hi.t;
                    vec2 interpolatedUv = vec2(0.0);
                    intersectTriangle(ray_origin, ray_dir, th.v0, th.v1, th.v2, th.n0, th.n1, th.n2, th.hasNormal, normal, th.uv0, th.uv1, th.uv2, th.hasTexture, interpolatedUv);
                }
                light = mat.albedo;
            }
            fcolor += mix(light, vec3(1.0), 0.0);
        } else {
            for (int i = 0; i < bounces; ++i) {
                int intersects = 0;
                HitInfo hi = find_closest(ray_origin, ray_dir, rayinv, intersects);
                float t1 = hi.t;
                if (hi.index == -1) {
                    vec2 skybox_uv = RayDirectionToUV(ray_dir);
                    vec3 sky_box = texture(hdri, skybox_uv).rgb;
                    sky_box = clamp(sky_box, 0.0f, 10.0f);
                    sky_box = (vec3(0,0,0) + sky_box);
                    light += sky_box * contribution;
                    break;
                }
                vec3 hit_point = vec3(0.0f);
                Material mat;
                vec3 normal;
                bool front_face = true;
                if (hi.is_sphere) {
                    Sphere sh = spheres[hi.index];
                    mat = materials[sh.matIndex];
                    hit_point = ray_origin + ray_dir * t1;
                    normal = normalize(hit_point - sh.center);
                } else {
                    Triangle th = triangle[hi.index];
                    mat = materials[th.matIndex];
                    hit_point = ray_origin + ray_dir * t1;
                    vec2 interpolatedUv = vec2(0.0);
                    intersectTriangle(ray_origin, ray_dir, th.v0, th.v1, th.v2, th.n0, th.n1, th.n2, th.hasNormal, normal, th.uv0, th.uv1, th.uv2, th.hasTexture, interpolatedUv);
                    if (th.hasTexture) {
                        vec3 texColor = texture(sampler2D(textureHandles[th.colourMapIndex]), interpolatedUv).rgb;
                        mat.albedo = texColor;
                    }
                }
                vec3 offset = normal * 0.01;
                ray_origin = hit_point + offset;
                vec3 copy = ray_dir;
                vec3 de;
                {
                    float eta = 1.8 * (1 - mat.metallic);
                    float eta_fraction = 1.0 / eta;
                    float f0 = (1.0 - eta_fraction) / (1.0 + eta_fraction);
                    f0 = f0 * f0;
                    float r0 = f0;
                    vec3 nwo = ray_dir;
                    float cos_theta = -dot(normal, nwo);
                    float reflectance = r0 + (1.0 - r0) * pow(1.0 - cos_theta, 5.0);
                    float rand_val = random();
                    vec3 diffuse = cosine_weighted_hemisphere(normal);
                    vec3 dielctic = diffuse;
                    de = diffuse;
                    if (rand_val * 1.2 < reflectance) {
                        vec3 rdir = reflect(nwo, normal);
                        dielctic = mix(rdir, diffuse, mat.roughness);
                        de = dielctic;
                    }
                }
                vec3 metal_dir = normalize(mix(reflect(ray_dir, normal), cosine_weighted_hemisphere(normal), mat.roughness));
                ray_dir = mix(de, metal_dir, mat.metallic);
                rayinv = 1.0 / ray_dir;
                contribution *= mix(contribution, mat.albedo, 1);
                
                light += get_emission(mat) * contribution;
                // Stop ray if material is emissive
                if (mat.emission_power > 0.0 || length(mat.emission_color) > 0.0) {
                    break;
                }
                if (dot(-normal, ray_dir) > 0.0) {
                    front_face = false;
                    normal = -normal;
                } else {
                    front_face = true;
                }
                if (abs(mat.eta) > 0.01) {
                    if (max_bounces == bounces) {
                        max_bounces += 8;
                    }
                    ray_dir = copy;
                    rayinv = 1.0 / ray_dir;
                    float eta = mat.eta;
                    float eta_fraction = 1.0 / eta;
                    float f0 = (1.0 - eta_fraction) / (1.0 + eta_fraction);
                    f0 = f0 * f0;
                    if (!front_face)
                        eta_fraction = eta;
                    vec3 nwo = ray_dir;
                    float cos_theta = -dot(normal, nwo);
                    float sin_theta_2 = 1.0 - (eta_fraction * eta_fraction) * (1.0 - cos_theta * cos_theta);
                    bool cannot_refract = sin_theta_2 <= 0.0;
                    float r0 = f0;
                    float reflectance = r0 + (1.0 - r0) * pow(1.0 - cos_theta, 5.0);
                    float rand_val = random();
                    vec3 dir;
                    vec3 origin;
                    if (!cannot_refract && rand_val * 1.2 > reflectance) {
                        origin = hit_point - normal * 0.001;
                        dir = refract(ray_dir, normal, eta_fraction);
                    } else {
                        origin = hit_point + normal * 0.01;
                        dir = reflect(nwo, normal);
                    }
                    ray_dir = normalize(dir);
                    rayinv = 1.0 / ray_dir;
                    ray_origin = origin;
                }
            }
            fcolor += mix(light / float(samples), vec3(1.0), 0.0);
        }
    }

    vec4 outColor = vec4(fcolor, 1.0);
    vec2 uv1 = coords.xy / iResolution.xy;
    vec4 prevCol = imageLoad(prevFrame, pix);
    if (iTime > 1.0f) {
        if (iFrame == 1) {
            imageStore(outputImage, pix, outColor);
            return;
        }
        imageStore(outputImage, pix, outColor + prevCol);
    }
    #endif
}
