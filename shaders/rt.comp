#define M_PI 3.14159265358979323846

// PCG hash (Jarzynski & Olano 2020, "Hash Functions for GPU Rendering").
uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// Per-pixel (or per-photon) offset for the stratified wavelength sequence (see sample_wavelength).
float pixelWavelengthOffset = 0.0;

// Seeds the per-thread stream from the pixel and the frame (hashed together: no wrap-around
// reuse of earlier streams however long it runs); the light-tracing pass gets its own salt so
// its photons are independent of the camera paths of the same pixel.
void initRandomGenerator(vec2 fragCoord)
{
    uint pixel = uint(fragCoord.y * iResolution.x + fragCoord.x);
#ifdef LIGHT_TRACE
    const uint salt = 0x68E31DA4u;
#else
    const uint salt = 0x1B56C4E9u;
#endif
    seed = pcg_hash(pixel ^ pcg_hash(uint(iFrame) ^ salt));
    pixelWavelengthOffset = float(pcg_hash(pixel) >> 8) * (1.0 / 16777216.0);
}

// PCG step: advance the LCG state, output its permuted hash in [0, 1).
float random()
{
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return float(((word >> 22u) ^ word) >> 8) * (1.0 / 16777216.0);
}

vec3 random_vec3()
{
    vec3 res;
    seed += 1u; // Change the seed for each component
    res.x = random();
    seed += 1u; // Change the seed for each component
    res.y = random();
    seed += 1u; // Change the seed for each component
    res.z = random();
    return normalize(res);
}

vec3 cosine_weighted_hemisphere(vec3 normal)
{
    float rand1 = random();
    float rand2 = random();
    float r = sqrt(rand1);
    float theta = 2.0 * 3.141592653589793 * rand2;

    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0 - rand1);

    vec3 s = vec3(x, y, z);
    vec3 w = normal;
    vec3 u = normalize(cross(abs(w.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0), w));
    vec3 v = cross(w, u);
    return normalize(s.x * u + s.y * v + s.z * w);
}
// Rotation matrix around the X axis.
mat3 rotateX(float theta)
{
    float c = cos(theta);
    float s = sin(theta);
    return mat3(
        vec3(1, 0, 0),
        vec3(0, c, -s),
        vec3(0, s, c));
}
// Rotation matrix around the Y axis.
mat3 rotateY(float theta)
{
    float c = cos(theta);
    float s = sin(theta);
    return mat3(
        vec3(c, 0, s),
        vec3(0, 1, 0),
        vec3(-s, 0, c));
}

// Rotation matrix around the Z axis.
mat3 rotateZ(float theta)
{
    float c = cos(theta);
    float s = sin(theta);
    return mat3(
        vec3(c, -s, 0),
        vec3(s, c, 0),
        vec3(0, 0, 1));
}

// Identity matrix.
mat3 identity()
{
    return mat3(
        vec3(1, 0, 0),
        vec3(0, 1, 0),
        vec3(0, 0, 1));
}
