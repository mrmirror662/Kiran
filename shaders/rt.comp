uint photon_cell(ivec3 c) {
    return pcg_hash(uint(c.x) ^ pcg_hash(uint(c.y) ^ pcg_hash(uint(c.z)))) & (photonGridSize - 1u);
}


vec3 get_emission(Material m)
{
    return m.emission_color * m.emission_power * emissionScale;
}
vec2 RayDirectionToUV(vec3 raydir) {
    // Step 1: Normalize the Ray Direction
    raydir = normalize(raydir);

    // Step 2: Convert Cartesian Coordinates to Spherical Coordinates
    // Assuming your skybox is centered at (0, 0, 0)
    // Calculate spherical coordinates
    float phi = atan(raydir.z, raydir.x);
    float theta = acos(raydir.y);

    // Step 3: Map Spherical Coordinates to UV Coordinates
    // Convert spherical coordinates to UV coordinates
    float u = (phi + 3.14159265359) / (2.0 * 3.14159265359);
    float v = theta / 3.14159265359;

    return vec2(u, v);
}
// Function to calculate intersection of a ray with a triangle using MllerTrumbore intersection algorithm
float intersectTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, vec3 n0, vec3 n1, vec3 n2, bool hasNormal, out vec3 normal, vec2 uv0, vec2 uv1, vec2 uv2, bool hasTexture, out vec2 interpolatedUv)
{
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(rd, edge2);
    float a = dot(edge1, h);

    if (abs(a) < 1e-12) // only reject (near-)parallel rays; det scales with triangle area
        return -1.0;

    float f = 1.0 / a;
    vec3 s = ro - v0;
    float u = f * dot(s, h);

    if (u < 0.0 || u > 1.0)
        return -1.0;

    vec3 q = cross(s, edge1);
    float v = f * dot(rd, q);

    if (v < 0.0 || u + v > 1.0)
        return -1.0;

    float t = f * dot(edge2, q);
    if (t > 1e-7) // ray intersection
    {
        // Compute the face normal
        vec3 faceNormal = normalize(cross(edge1, edge2));
        float w = 1.0 - u - v;

        // UVs are zero when the mesh has none; base-color and emissive maps both use them.
        interpolatedUv = u * uv1 + v * uv2 + w * uv0;

        // Always interpolate normals if normal data is available
        if (hasNormal)
        {
            // Interpolate the normal using barycentric coordinates
            normal = normalize(u * n1 + v * n2 + w * n0);
        }
        else
        {
            // Use the face normal if no vertex normals are provided
            normal = faceNormal;
        }

        // Ensure the normal faces opposite to the ray direction
        if (dot(normal, rd) > 0.0)
        {
            normal = -normal;
        }

        return t;
    }
    return -1.0;
}
// Lightweight triangle intersection: returns t and the barycentrics (u, v) of v1, v2
float intersectTriangleSimple(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out vec2 bary)
{
    bary = vec2(0.0);
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(rd, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 1e-12) // only reject (near-)parallel rays; det scales with triangle area
        return -1.0;
    float f = 1.0 / a;
    vec3 s = ro - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0)
        return -1.0;
    vec3 q = cross(s, edge1);
    float v = f * dot(rd, q);
    if (v < 0.0 || u + v > 1.0)
        return -1.0;
    float t = f * dot(edge2, q);
    bary = vec2(u, v);
    if (t > 0.0001)
        return t;
    return -1.0;
}
// Function to calculate the intersection of a ray with a sphere
float get_t(vec3 ray_origin, vec3 ray_dir, vec3 center, float r)
{
    vec3 oc = ray_origin - center;
    float a = dot(ray_dir, ray_dir);
    float b = 2.0 * dot(oc, ray_dir);
    float c = dot(oc, oc) - r * r;
    float d = b * b - 4.0 * a * c;

    if (d < 0.0) // discriminant scales with radius; only reject true misses
        return -1.0;

    float sqrt_d = sqrt(d);
    float t1 = (-b - sqrt_d) / (2.0 * a);
    float t2 = (-b + sqrt_d) / (2.0 * a);

    // Return the smallest positive t value
    if (t1 > 0.0)
        return t1;
    if (t2 > 0.0)
        return t2;
    return -1.0;
}
// Update intersectBox to take rayinv as argument
bool intersectBox(vec3 ray_origin, vec3 ray_dir, vec3 rayinv, vec3 min_, vec3 max_, out float tmin, out float tmax) {
    vec3 oinv = ray_origin * rayinv;
    vec3 t0s = fma(min_, rayinv, -oinv);
    vec3 t1s = fma(max_, rayinv, -oinv);
    vec3 tSmall = min(t0s, t1s);
    vec3 tLarge = max(t0s, t1s);
    float epsilon = 0.0001;
    tmin = max(max(tSmall.x, tSmall.y), tSmall.z);
    tmax = min(min(tLarge.x, tLarge.y), tLarge.z);
    return tmax >= tmin && tmax > 0.0;
}
// Struct to store intersection information
struct HitInfo
{
    float t;
    int index;
    bool is_sphere;
    int instance;
};

// Tests a BLAS leaf's triangles; returns true when anyHit found an occluder.
// Alpha test for flagged triangles (triVerts[3 i].w): MASK keeps the hit where the base
// color alpha reaches the cutoff; BLEND keeps it with probability alpha (unbiased coverage).
bool alpha_passes(int i, vec2 bary, float flag) {
    vec2 uv = (1.0 - bary.x - bary.y) * triangle[i].uv0 + bary.x * triangle[i].uv1 + bary.y * triangle[i].uv2;
    float a = textureLod(textureHandles[triangle[i].colourMapIndex], uv, 0.0).a;
    return flag > 0.0 ? a >= flag : random() < a;
}

bool intersect_leaf(vec3 ro, vec3 rd, int first, int count, bool anyHit, inout float best_t, inout int best_tri, inout int intersects) {
    for (int i = first; i < first + count; ++i) {
        vec4 p0 = triVerts[3 * i];
        vec2 bary;
        float t = intersectTriangleSimple(ro, rd, p0.xyz, triVerts[3 * i + 1].xyz, triVerts[3 * i + 2].xyz, bary);
        intersects++;
        if (t > 0.0 && t < best_t && (p0.w == 0.0 || alpha_passes(i, bary, p0.w))) {
            best_t = t;
            best_tri = i;
            if (anyHit)
                return true;
        }
    }
    return false;
}

// Closest hit within one BLAS. The ray is in object space; its direction is not
// normalized, so t stays in world units and is comparable across instances.
// The instance's bounds were already tested in the TLAS, so traversal starts at the root.
// Each node holds both child boxes: leaf children are tested immediately, interior ones
// pushed far-then-near with their entry distance (cheap cull when popped).
void traverse_blas(vec3 ro, vec3 rd, vec3 rinv, int root, bool anyHit, inout float best_t, inout int best_tri, inout int intersects) {
    int stack[32];
    stack[0] = root;
    int stack_top = 1;
    while (stack_top > 0) {
        --stack_top;
        BVHNode n = blas_node(stack[stack_top]);
        float tl, tr, tfar;
        bool hl = n.lref >= 0 && intersectBox(ro, rd, rinv, n.lmin, n.lmax, tl, tfar) && tl < best_t;
        bool hr = n.rref >= 0 && intersectBox(ro, rd, rinv, n.rmin, n.rmax, tr, tfar) && tr < best_t;
        intersects += 2;
        bool leafL = hl && n.lcount > 0, leafR = hr && n.rcount > 0;
        bool rightFirst = leafR && (!leafL || tr < tl);
        for (int k = 0; k < 2; ++k) {
            bool right = (k == 0) == rightFirst;
            if (!(right ? leafR : leafL) || (right ? tr : tl) > best_t)
                continue;
            if (intersect_leaf(ro, rd, right ? n.rref : n.lref, right ? n.rcount : n.lcount, anyHit, best_t, best_tri, intersects))
                return;
        }
        hl = hl && !leafL;
        hr = hr && !leafR;
        if (hl && hr) {
            bool leftFirst = tl < tr;
            stack[stack_top] = leftFirst ? n.rref : n.lref;
            ++stack_top;
            stack[stack_top] = leftFirst ? n.lref : n.rref;
            ++stack_top;
        } else if (hl) {
            stack[stack_top] = n.lref;
            ++stack_top;
        } else if (hr) {
            stack[stack_top] = n.rref;
            ++stack_top;
        }
    }
}

// Tests the instances of a TLAS leaf by re-casting the ray into each one's object space.
bool intersect_instances(vec3 ray_origin, vec3 ray_dir, int first, int count, bool anyHit, inout float min_t, inout int min_index, inout int min_instance, inout int intersects) {
    for (int i = first; i < first + count; ++i) {
        mat4 w2o = instances[i].worldToObject;
        vec3 ro = (w2o * vec4(ray_origin, 1.0)).xyz;
        vec3 rd = mat3(w2o) * ray_dir;
        int tri = -1;
        traverse_blas(ro, rd, 1.0 / rd, instances[i].blasRoot, anyHit, min_t, tri, intersects);
        if (tri != -1) {
            min_index = tri;
            min_instance = i;
            if (anyHit)
                return true;
        }
    }
    return false;
}

// Closest sphere/triangle hit. Walks the TLAS in world space and, per instance,
// re-casts the ray in object space into that instance's BLAS.
// tmax bounds the search; anyHit returns the first occluder found (shadow rays).
HitInfo find_closest(vec3 ray_origin, vec3 ray_dir, vec3 rayinv, float tmax, bool anyHit, out int intersects) {
    float min_t = tmax;
    int min_index = -1;
    int min_instance = -1;
    intersects = 0;
    for (int i = 0; i < sphere_size; ++i) {
        float t = get_t(ray_origin, ray_dir, spheres[i].center, spheres[i].r);
        if (t > 0.0 && t < min_t) {
            min_t = t;
            min_index = i;
            if (anyHit)
                return HitInfo(min_t, min_index, true, -1);
        }
    }
    int sphere_index = min_index;

    int stack[32];
    int stack_top = 0;
    if (tlas_size > 0) {
        stack[0] = 0;
        stack_top = 1;
    }
    while (stack_top > 0) {
        --stack_top;
        BVHNode n = tlas_node(stack[stack_top]);
        float tl, tr, tfar;
        bool hl = n.lref >= 0 && intersectBox(ray_origin, ray_dir, rayinv, n.lmin, n.lmax, tl, tfar) && tl < min_t;
        bool hr = n.rref >= 0 && intersectBox(ray_origin, ray_dir, rayinv, n.rmin, n.rmax, tr, tfar) && tr < min_t;
        intersects += 2;
        // Leaf children (instances) are visited nearer-first from a single call site,
        // keeping the inlined BLAS traversal to one copy.
        bool leafL = hl && n.lcount > 0, leafR = hr && n.rcount > 0;
        bool rightFirst = leafR && (!leafL || tr < tl);
        for (int k = 0; k < 2; ++k) {
            bool right = (k == 0) == rightFirst;
            if (!(right ? leafR : leafL) || (right ? tr : tl) > min_t)
                continue;
            if (intersect_instances(ray_origin, ray_dir, right ? n.rref : n.lref, right ? n.rcount : n.lcount, anyHit, min_t, min_index, min_instance, intersects))
                return HitInfo(min_t, min_index, false, min_instance);
        }
        hl = hl && !leafL;
        hr = hr && !leafR;
        if (hl && hr) {
            bool leftFirst = tl < tr;
            stack[stack_top] = leftFirst ? n.rref : n.lref;
            ++stack_top;
            stack[stack_top] = leftFirst ? n.lref : n.rref;
            ++stack_top;
        } else if (hl) {
            stack[stack_top] = n.lref;
            ++stack_top;
        } else if (hr) {
            stack[stack_top] = n.rref;
            ++stack_top;
        }
    }
    bool is_sphere = min_instance == -1;
    return HitInfo(min_t, is_sphere ? sphere_index : min_index, is_sphere, min_instance);
}

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

int instance_material(int inst, int tri) {
    int o = instances[inst].materialOverride;
    return o >= 0 ? o : triangle[tri].matIndex;
}

void world_triangle(int inst, int tri, out vec3 p0, out vec3 p1, out vec3 p2) {
    mat4 o2w = instances[inst].objectToWorld;
    p0 = (o2w * vec4(triVerts[3 * tri].xyz, 1.0)).xyz;
    p1 = (o2w * vec4(triVerts[3 * tri + 1].xyz, 1.0)).xyz;
    p2 = (o2w * vec4(triVerts[3 * tri + 2].xyz, 1.0)).xyz;
}

// Solid-angle pdf of sampling the cone subtended by a sphere from x (0 if inside).
float sphere_cone_pdf(vec3 x, vec3 center, float radius) {
    vec3 dc = center - x;
    float d2 = dot(dc, dc);
    if (d2 <= radius * radius)
        return 0.0;
    float cosMax = sqrt(max(0.0, 1.0 - radius * radius / d2));
    return 1.0 / (2.0 * PI * (1.0 - cosMax));
}

// cos/sin of max(0, a - b) given the cosines and sines of angles a and b.
float cos_sub_clamped(float sa, float ca, float sb, float cb) { return ca > cb ? 1.0 : ca * cb + sa * sb; }
float sin_sub_clamped(float sa, float ca, float sb, float cb) { return ca > cb ? 0.0 : sa * cb - ca * sb; }

// Conservative estimate of a light cluster's contribution at p with normal n
// (pbrt-v4 LightBounds::Importance): power / distance^2, reduced by the angle between
// the cluster's emission cone and p, and by the cosine at the receiving surface.
float light_node_importance(int nodeIndex, vec3 p, vec3 n) {
    LightNode node = lightNodes[nodeIndex];
    vec3 bmin = node.boundsMinPhi.xyz, bmax = node.boundsMaxCosO.xyz;
    float phi = node.boundsMinPhi.w;
    float cosTheta_o = node.boundsMaxCosO.w;
    float cosTheta_e = node.axisCosE.w;
    vec3 pc = 0.5 * (bmin + bmax);
    float dist2 = dot(p - pc, p - pc);
    float d2 = max(dist2, length(bmax - bmin) * 0.5);

    vec3 wi = normalize(p - pc);
    float cosTheta_w = dot(node.axisCosE.xyz, wi);
    if ((node.flags & 2) != 0)
        cosTheta_w = abs(cosTheta_w);
    float sinTheta_w = sqrt(max(0.0, 1.0 - cosTheta_w * cosTheta_w));

    // Cone of directions from p that the bounds subtend.
    float r2 = dot(bmax - bmin, bmax - bmin) * 0.25;
    float cosTheta_b = dist2 < r2 ? -1.0 : sqrt(max(0.0, 1.0 - r2 / dist2));
    float sinTheta_b = sqrt(max(0.0, 1.0 - cosTheta_b * cosTheta_b));

    // Angle between the emission cone and p, minus the cone and the bounds' extent.
    float sinTheta_o = sqrt(max(0.0, 1.0 - cosTheta_o * cosTheta_o));
    float cosTheta_x = cos_sub_clamped(sinTheta_w, cosTheta_w, sinTheta_o, cosTheta_o);
    float sinTheta_x = sin_sub_clamped(sinTheta_w, cosTheta_w, sinTheta_o, cosTheta_o);
    float cosTheta_p = cos_sub_clamped(sinTheta_x, cosTheta_x, sinTheta_b, cosTheta_b);
    if (cosTheta_p <= cosTheta_e)
        return 0.0;
    float importance = phi * cosTheta_p / d2;

    // Receiving-surface cosine, loosened by the bounds' extent (none in a medium: n = 0).
    if (dot(n, n) > 0.0) {
        float cosTheta_i = abs(dot(wi, n));
        float sinTheta_i = sqrt(max(0.0, 1.0 - cosTheta_i * cosTheta_i));
        importance *= cos_sub_clamped(sinTheta_i, cosTheta_i, sinTheta_b, cosTheta_b);
    }
    return max(importance, 0.0);
}

float infinite_light_prob() {
    if (infinite_light_count == 0)
        return 0.0;
    return float(infinite_light_count) / float(infinite_light_count + (light_node_count > 0 ? 1 : 0));
}

// Directional lights with an angular size (dirB.w = cos of the half-angle, 0: delta) are discs
// at infinity: uniform radiance over the cone, normalized so the irradiance at normal
// incidence is the light's `emit` (E = L pi sin^2 theta).
vec3 sun_radiance(Light L) {
    return L.emit.rgb * emissionScale / (PI * max(1.0 - L.dirB.w * L.dirB.w, 1e-12));
}
float sun_cone_pdf(Light L) {
    return 1.0 / (2.0 * PI * (1.0 - L.dirB.w));
}
vec3 sample_sun_dir(Light L) {
    float cosT = 1.0 - random() * (1.0 - L.dirB.w);
    float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));
    float phi = 2.0 * PI * random();
    vec3 w = -L.dirB.xyz;
    vec3 a = normalize(cross(abs(w.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0), w));
    vec3 b = cross(w, a);
    return normalize(a * (cos(phi) * sinT) + b * (sin(phi) * sinT) + w * cosT);
}

// Picks a light for shading point (p, n) with one random number; -1 if none.
int sample_light_index(vec3 p, vec3 n, out float pmf) {
    float u = random();
    float pInf = infinite_light_prob();
    if (u < pInf) {
        int k = min(int(u / pInf * float(infinite_light_count)), infinite_light_count - 1);
        pmf = pInf / float(infinite_light_count);
        return k;
    }
    if (light_node_count == 0)
        return -1;
    u = min((u - pInf) / (1.0 - pInf), 0.99999994);
    pmf = 1.0 - pInf;
    int node = 0;
    for (int depth = 0; depth < 64; ++depth) {
        LightNode nd = lightNodes[node];
        if ((nd.flags & 1) != 0)
            return (node > 0 || light_node_importance(node, p, n) > 0.0) ? nd.childOrLight : -1;
        float c0 = light_node_importance(node + 1, p, n);
        float c1 = light_node_importance(nd.childOrLight, p, n);
        if (c0 == 0.0 && c1 == 0.0)
            return -1;
        float p0 = c0 / (c0 + c1);
        if (u < p0) {
            u = min(u / p0, 0.99999994);
            pmf *= p0;
            node = node + 1;
        } else {
            u = min((u - p0) / (1.0 - p0), 0.99999994);
            pmf *= 1.0 - p0;
            node = nd.childOrLight;
        }
    }
    return -1;
}

// Probability that sample_light_index(p, n) returns this light (follows its bit trail).
float light_pmf(vec3 p, vec3 n, int lightIndex) {
    if (lightIndex < infinite_light_count)
        return infinite_light_prob() / float(infinite_light_count);
    float pmf = 1.0 - infinite_light_prob();
    uint trail = uint(lights[lightIndex].bitTrail);
    int node = 0;
    for (int depth = 0; depth < 64; ++depth) {
        LightNode nd = lightNodes[node];
        if ((nd.flags & 1) != 0)
            return pmf;
        float c0 = light_node_importance(node + 1, p, n);
        float c1 = light_node_importance(nd.childOrLight, p, n);
        if (c0 + c1 <= 0.0)
            return 0.0;
        bool right = (trail & 1u) != 0u;
        pmf *= (right ? c1 : c0) / (c0 + c1);
        node = right ? nd.childOrLight : node + 1;
        trail >>= 1;
    }
    return pmf;
}

// Samples one light (light BVH importance at x with normal n) and a direction to it.
//   wi/dist: direction and shadow-ray length; Li: radiance arriving along wi (for delta
//   lights: intensity / d^2 or irradiance); pdf: solid-angle pdf including selection
//   (selection probability only for delta lights). Returns false if it contributes nothing.
bool sample_light(vec3 x, vec3 n, out vec3 wi, out float dist, out vec3 Li, out float pdf, out bool isDelta) {
    float pSel;
    int li = sample_light_index(x, n, pSel);
    if (li < 0 || pSel <= 0.0)
        return false;
    Light L = lights[li];
    isDelta = L.type <= LIGHT_DIRECTIONAL && !(L.type == LIGHT_DIRECTIONAL && L.dirB.w > 0.0);

    if (L.type == LIGHT_POINT || L.type == LIGHT_SPOT) {
        vec3 toL = L.posA.xyz - x;
        float d2 = dot(toL, toL);
        dist = sqrt(d2);
        wi = toL / dist;
        Li = L.emit.rgb * emissionScale / d2;
        if (L.type == LIGHT_SPOT)
            Li *= smoothstep(L.dirB.w, L.posA.w, dot(-wi, L.dirB.xyz));
        pdf = pSel;
        return true;
    }
    if (L.type == LIGHT_DIRECTIONAL) {
        dist = 1e30;
        if (L.dirB.w > 0.0) { // sized sun: uniform over its cone
            wi = sample_sun_dir(L);
            Li = sun_radiance(L);
            pdf = pSel * sun_cone_pdf(L);
            return true;
        }
        wi = -L.dirB.xyz;
        Li = L.emit.rgb * emissionScale;
        pdf = pSel;
        return true;
    }
    if (L.type == LIGHT_SPHERE) {
        // Uniform sampling of the cone the sphere subtends.
        vec3 c = L.posA.xyz;
        float r = L.posA.w;
        vec3 dc = c - x;
        float d2 = dot(dc, dc);
        if (d2 <= r * r)
            return false;
        float cosMax = sqrt(max(0.0, 1.0 - r * r / d2));
        float cosT = 1.0 - random() * (1.0 - cosMax);
        float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));
        float phi = 2.0 * PI * random();
        vec3 w = dc * inversesqrt(d2);
        vec3 a = normalize(cross(abs(w.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0), w));
        vec3 b = cross(w, a);
        wi = normalize(a * (cos(phi) * sinT) + b * (sin(phi) * sinT) + w * cosT);
        dist = get_t(x, wi, c, r);
        if (dist <= 0.0)
            return false;
        Li = get_emission(materials[spheres[L.instance].matIndex]);
        pdf = pSel / (2.0 * PI * (1.0 - cosMax));
        return true;
    }
    // Emissive triangle: uniform point on its world-space surface.
    vec3 p0, p1, p2;
    world_triangle(L.instance, L.tri, p0, p1, p2);
    float r1 = sqrt(random());
    float r2 = random();
    float b0 = 1.0 - r1, b1 = r1 * (1.0 - r2), b2 = r1 * r2;
    vec3 p = b0 * p0 + b1 * p1 + b2 * p2;
    vec3 cr = cross(p1 - p0, p2 - p0);
    float area = 0.5 * length(cr);
    vec3 toL = p - x;
    float d2 = dot(toL, toL);
    dist = sqrt(d2);
    wi = toL / dist;
    float cosL = abs(dot(cr / (2.0 * area), wi));
    if (cosL < 1e-6)
        return false;
    Material m = materials[instance_material(L.instance, L.tri)];
    if (m.emissionMap >= 0) {
        Triangle th = triangle[L.tri];
        m.emission_color *= texture(textureHandles[m.emissionMap], b0 * th.uv0 + b1 * th.uv1 + b2 * th.uv2).rgb;
    }
    Li = get_emission(m);
    pdf = pSel / area * d2 / cosL;
    return true;
}

// Below neeDepth only delta lights need light sampling (BSDF rays can't hit them), so pick
// one uniformly from the small delta list instead of walking the light BVH.
bool sample_delta_light(vec3 x, out vec3 wi, out float dist, out vec3 Li, out float pdf) {
    int k = min(int(random() * float(delta_light_count)), delta_light_count - 1);
    Light L = lights[deltaLights[k]];
    pdf = 1.0 / float(delta_light_count);
    if (L.type == LIGHT_DIRECTIONAL) {
        wi = -L.dirB.xyz;
        dist = 1e30;
        Li = L.emit.rgb * emissionScale;
        return true;
    }
    vec3 toL = L.posA.xyz - x;
    float d2 = dot(toL, toL);
    dist = sqrt(d2);
    wi = toL / dist;
    Li = L.emit.rgb * emissionScale / d2;
    if (L.type == LIGHT_SPOT)
        Li *= smoothstep(L.dirB.w, L.posA.w, dot(-wi, L.dirB.xyz));
    return true;
}

vec3 uniform_sphere_dir() {
    float z = 1.0 - 2.0 * random();
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 2.0 * PI * random();
    return vec3(r * cos(phi), r * sin(phi), z);
}


// ---------------------------------------------------------------------------------------
// Spectral dispersion. A path samples a wavelength the first time it meets dispersive glass;
// its RGB throughput is then weighted by that wavelength's colour (CIE 1931 via the Wyman et
// al. 2013 analytic fit, to linear sRGB, clamped, normalised so white averages to white).
// ---------------------------------------------------------------------------------------
uniform vec3 spectralNorm; // integral of the clamped sRGB colour over [360, 830] nm

float cie_lobe(float l, float mu, float s1, float s2) {
    float t = (l - mu) / (l < mu ? s1 : s2);
    return exp(-0.5 * t * t);
}

vec3 wavelength_rgb(float l) {
    float x = 1.056 * cie_lobe(l, 599.8, 37.9, 31.0) + 0.362 * cie_lobe(l, 442.0, 16.0, 26.7) - 0.065 * cie_lobe(l, 501.1, 20.4, 26.2);
    float y = 0.821 * cie_lobe(l, 568.8, 46.9, 40.5) + 0.286 * cie_lobe(l, 530.9, 16.3, 31.1);
    float z = 1.217 * cie_lobe(l, 437.0, 11.8, 36.0) + 0.681 * cie_lobe(l, 459.0, 26.0, 13.8);
    vec3 rgb = vec3(3.2406 * x - 1.5372 * y - 0.4986 * z,
                    -0.9689 * x + 1.8758 * y + 0.0415 * z,
                    0.0557 * x - 0.2040 * y + 1.0570 * z);
    return max(rgb, vec3(0.0)) / spectralNorm;
}

// Wavelength for a path that meets dispersive glass (pbrt-v4 SampleVisibleWavelengths):
// importance-sampled towards the eye's sensitivity on [360, 830] nm, with the random number
// a per-pixel rotation of a golden-ratio sequence over frames (each sample stays uniform, so
// the estimate is unbiased, but consecutive frames sweep the spectrum evenly). Returns the
// wavelength; `weight` is its colour / pdf, white-balanced (its mean over wavelengths is 1).
float sample_wavelength(out vec3 weight) {
    float u = fract(pixelWavelengthOffset + float(iFrame) * 0.6180339887);
    float lambda = 538.0 - 138.888889 * atanh(0.85691062 - 1.82750197 * u);
    float c = cosh(0.0072 * (lambda - 538.0));
    float pdf = 0.0039398042 / (c * c);
    weight = wavelength_rgb(lambda) / pdf;
    return lambda;
}

// KHR_materials_dispersion: n(lambda) from n_d and the Abbe number V = 20 / dispersion.
float dispersive_ior(float nd, float dispersion, float lambda) {
    if (dispersion <= 0.0 || lambda <= 0.0)
        return nd;
    float V = 20.0 / dispersion;
    return max(nd + (nd - 1.0) / V * (523655.0 / (lambda * lambda) - 1.5168), 1.0);
}

// Unpolarized Fresnel reflectance of a smooth dielectric; etaRatio = eta_incident / eta_transmitted.
float fresnel_dielectric(float cosI, float etaRatio) {
    float sin2T = etaRatio * etaRatio * (1.0 - cosI * cosI);
    if (sin2T >= 1.0)
        return 1.0; // total internal reflection
    float cosT = sqrt(1.0 - sin2T);
    float rs = (etaRatio * cosI - cosT) / (etaRatio * cosI + cosT);
    float rp = (cosI - etaRatio * cosT) / (cosI + etaRatio * cosT);
    return 0.5 * (rs * rs + rp * rp);
}

// ---------------------------------------------------------------------------------------
// Homogeneous fog: box overlap, transmittance, Henyey-Greenstein phase function.
// ---------------------------------------------------------------------------------------
// Overlap [t0, t1] of a ray (unit direction) with the fog box, clipped to [0, tmax].
bool fog_overlap(vec3 o, vec3 d, float tmax, out float t0, out float t1) {
    // Into the box's frame (rigid, so distances along the ray are unchanged).
    vec3 lo_ = (fogToLocal * vec4(o, 1.0)).xyz, ld = mat3(fogToLocal) * d;
    vec3 inv = 1.0 / ld;
    vec3 a = (fogMin - lo_) * inv, b = (fogMax - lo_) * inv;
    vec3 lo = min(a, b), hi = max(a, b);
    t0 = max(max(max(lo.x, lo.y), lo.z), 0.0);
    t1 = min(min(min(hi.x, hi.y), hi.z), tmax);
    return t1 > t0;
}

vec3 fog_transmittance(vec3 o, vec3 d, float tmax) {
    float t0, t1;
    if (fogEnabled == 0 || !fog_overlap(o, d, tmax, t0, t1))
        return vec3(1.0);
    return exp(-(fogSigmaS + fogSigmaA) * (t1 - t0));
}

void make_basis(vec3 n, out vec3 t, out vec3 b);

// HG phase for the angle between the propagation direction and the scattered direction.
float hg_phase(float cosTheta, float g) {
    float d = 1.0 + g * g - 2.0 * g * cosTheta;
    return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
}

// Samples a scattered direction around dirIn proportionally to the HG phase.
vec3 sample_hg(vec3 dirIn, float g) {
    float u = random();
    float cosTheta;
    if (abs(g) < 1e-3) {
        cosTheta = 1.0 - 2.0 * u;
    } else {
        float sq = (1.0 - g * g) / (1.0 + g - 2.0 * g * u);
        cosTheta = (1.0 + g * g - sq * sq) / (2.0 * g);
    }
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 2.0 * PI * random();
    vec3 t, b;
    make_basis(dirIn, t, b);
    return normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + dirIn * cosTheta);
}

// Direct in-scattering along the fog part [t0, t1] of a segment: pick a light and a point on
// it, then sample the distance equiangularly around that point (Kulla & Fajardo 2012). Returns
// a shadow ray to trace and the contribution it carries if unoccluded.
bool equiangular_direct(vec3 o, vec3 dir, float t0, float t1, vec3 beta, out vec3 so, out vec3 sd, out float smax, out vec3 value);

// ---------------------------------------------------------------------------------------
// Microfacet BSDF: GGX / Trowbridge-Reitz with separable Smith masking, glTF metallic-
// roughness model. Vectors are world space; n faces the side wo is on.
// ---------------------------------------------------------------------------------------
float ggx_alpha(float roughness) { return max(roughness * roughness, 0.002); }

float ggx_D(float NdotH, float a2) {
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float smith_G1(float NdotV, float a2) {
    NdotV = max(NdotV, 1e-6);
    return 2.0 * NdotV / (NdotV + sqrt(a2 + (1.0 - a2) * NdotV * NdotV));
}

// Orthonormal basis around n (Duff et al. 2017).
void make_basis(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

// Visible-normal sampling (Heitz 2018): a microfacet normal seen from wo, in world space.
vec3 sample_ggx_vndf(vec3 n, vec3 wo, float a) {
    vec3 t, b;
    make_basis(n, t, b);
    vec3 v = vec3(dot(wo, t), dot(wo, b), dot(wo, n));
    vec3 vh = normalize(vec3(a * v.x, a * v.y, v.z));
    float lensq = vh.x * vh.x + vh.y * vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(vh, T1);
    float r = sqrt(random());
    float phi = 2.0 * PI * random();
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float sh = 0.5 * (1.0 + vh.z);
    t2 = (1.0 - sh) * sqrt(max(0.0, 1.0 - t1 * t1)) + sh * t2;
    vec3 nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * vh;
    vec3 hl = normalize(vec3(a * nh.x, a * nh.y, max(1e-6, nh.z)));
    return t * hl.x + b * hl.y + n * hl.z;
}

float dielectric_f0(Material m) {
    float ior = m.eta > 0.0 ? m.eta : 1.5; // glTF default ior
    float r = (ior - 1.0) / (ior + 1.0);
    return r * r;
}

// Probability of sampling the specular lobe (rest: cosine-weighted diffuse).
float specular_lobe_prob(Material m, float NdotV) {
    float f0 = dielectric_f0(m);
    float Fd = f0 + (1.0 - f0) * pow(1.0 - NdotV, 5.0);
    return clamp(mix(Fd, 1.0, m.metallic), 0.05, 0.95);
}

// Opaque BRDF f(wo, wi) = mix(fresnel_mix(diffuse, specular), conductor specular, metallic),
// and the pdf of opaque_sample choosing wi.
vec3 opaque_eval(Material m, vec3 n, vec3 wo, vec3 wi, out float pdf) {
    pdf = 0.0;
    float NdotL = dot(n, wi), NdotV = dot(n, wo);
    if (NdotL <= 0.0 || NdotV <= 0.0)
        return vec3(0.0);
    vec3 h = normalize(wo + wi);
    float NdotH = max(dot(n, h), 0.0), VdotH = max(dot(wo, h), 0.0);
    float a = ggx_alpha(m.roughness), a2 = a * a;
    float D = ggx_D(NdotH, a2);
    float G1V = smith_G1(NdotV, a2);
    float spec = D * G1V * smith_G1(NdotL, a2) / (4.0 * NdotV * NdotL);
    float f0 = dielectric_f0(m);
    float Fd = f0 + (1.0 - f0) * pow(1.0 - VdotH, 5.0);
    vec3 dielectric = (1.0 - Fd) * m.albedo / PI + vec3(Fd * spec);
    vec3 metal = (m.albedo + (1.0 - m.albedo) * pow(1.0 - VdotH, 5.0)) * spec;
    float pSpec = specular_lobe_prob(m, NdotV);
    pdf = pSpec * D * G1V / (4.0 * NdotV) + (1.0 - pSpec) * NdotL / PI;
    return mix(dielectric, metal, m.metallic);
}

// Samples an outgoing direction for the opaque BRDF (lobe mixture).
bool opaque_sample(Material m, vec3 n, vec3 wo, out vec3 wi) {
    float NdotV = dot(n, wo);
    if (NdotV <= 0.0)
        return false;
    if (random() < specular_lobe_prob(m, NdotV))
        wi = reflect(-wo, sample_ggx_vndf(n, wo, ggx_alpha(m.roughness)));
    else
        wi = cosine_weighted_hemisphere(n);
    return dot(n, wi) > 0.0;
}

bool equiangular_direct(vec3 o, vec3 dir, float t0, float t1, vec3 beta, out vec3 so, out vec3 sd, out float smax, out vec3 value) {
    float pmf;
    int li = sample_light_index(o + dir * (0.5 * (t0 + t1)), vec3(0.0), pmf);
    if (li < 0 || pmf <= 0.0)
        return false;
    Light L = lights[li];
    vec3 sigmaT = fogSigmaS + fogSigmaA;
    if (L.type == LIGHT_DIRECTIONAL) {
        // No point to centre on: uniform distance over the overlap.
        float t = mix(t0, t1, random());
        so = o + dir * t;
        smax = 1e30;
        vec3 Le = L.emit.rgb * emissionScale;
        if (L.dirB.w > 0.0) { // sized sun: a direction in its cone, radiance / cone pdf
            sd = sample_sun_dir(L);
            Le = sun_radiance(L) / sun_cone_pdf(L);
        } else {
            sd = -L.dirB.xyz;
        }
        value = beta * fogSigmaS * exp(-sigmaT * (t - t0)) * hg_phase(dot(dir, sd), fogG) * Le *
                fog_transmittance(so, sd, 1e30) * (t1 - t0) / pmf;
        return true;
    }
    // A point y on the light (area pdf pA), its emitted radiance / intensity and normal.
    vec3 y, ny = vec3(0.0), Le;
    float pA = pmf;
    int kind = 0; // 0: delta, 1: one-sided (sphere), 2: two-sided (triangle)
    if (L.type == LIGHT_POINT || L.type == LIGHT_SPOT) {
        y = L.posA.xyz;
        Le = L.emit.rgb * emissionScale;
    } else if (L.type == LIGHT_SPHERE) {
        ny = uniform_sphere_dir();
        y = L.posA.xyz + L.posA.w * ny;
        Le = get_emission(materials[spheres[L.instance].matIndex]);
        pA = pmf / (4.0 * PI * L.posA.w * L.posA.w);
        kind = 1;
    } else {
        vec3 p0, p1, p2;
        world_triangle(L.instance, L.tri, p0, p1, p2);
        float r1 = sqrt(random()), r2 = random();
        float b0 = 1.0 - r1, b1 = r1 * (1.0 - r2), b2 = r1 * r2;
        y = b0 * p0 + b1 * p1 + b2 * p2;
        vec3 cr = cross(p1 - p0, p2 - p0);
        ny = normalize(cr);
        Material m = materials[instance_material(L.instance, L.tri)];
        if (m.emissionMap >= 0) {
            Triangle th = triangle[L.tri];
            m.emission_color *= texture(textureHandles[m.emissionMap], b0 * th.uv0 + b1 * th.uv1 + b2 * th.uv2).rgb;
        }
        Le = get_emission(m);
        pA = pmf / (0.5 * length(cr));
        kind = 2;
    }
    // Equiangular sampling of t around y's projection on the ray.
    float delta = dot(y - o, dir);
    float D = max(length(y - (o + dir * delta)), 1e-5);
    float thA = atan((t0 - delta) / D), thB = atan((t1 - delta) / D);
    if (thB - thA < 1e-7)
        return false;
    float t = delta + D * tan(mix(thA, thB, random()));
    float pdfT = D / ((thB - thA) * (D * D + (t - delta) * (t - delta)));
    vec3 x = o + dir * t;
    vec3 toL = y - x;
    float d2 = dot(toL, toL);
    float dist = sqrt(d2);
    vec3 wl = toL / dist;
    float G = 1.0 / d2;
    if (kind == 1) {
        float c = dot(ny, -wl);
        if (c <= 0.0)
            return false;
        G *= c;
    } else if (kind == 2) {
        G *= abs(dot(ny, wl));
    } else if (L.type == LIGHT_SPOT) {
        Le *= smoothstep(L.dirB.w, L.posA.w, dot(-wl, L.dirB.xyz));
    }
    so = x;
    sd = wl;
    smax = dist * (1.0 - 1e-3);
    value = beta * fogSigmaS * exp(-sigmaT * (t - t0)) * hg_phase(dot(dir, wl), fogG) * Le * G *
            fog_transmittance(x, wl, dist) / (pA * pdfT);
    return true;
}

// Surface data for a triangle hit: re-intersects in the instance's object space,
// then brings the normal to world space with the inverse transpose of objectToWorld
// (which keeps it facing against the ray).
// frontFace: the ray hit the outward (counter-clockwise) side, judged in object space so
// mirroring instance transforms don't flip it.
Triangle hit_surface(HitInfo hi, vec3 ray_origin, vec3 ray_dir, out Material mat, out vec3 normal, out vec2 uv, out bool frontFace) {
    Instance inst = instances[hi.instance];
    Triangle th = triangle[hi.index];
    vec3 ro = (inst.worldToObject * vec4(ray_origin, 1.0)).xyz;
    vec3 rd = mat3(inst.worldToObject) * ray_dir;
    frontFace = dot(cross(th.v1 - th.v0, th.v2 - th.v0), rd) < 0.0;
    uv = vec2(0.0);
    intersectTriangle(ro, rd, th.v0, th.v1, th.v2, th.n0, th.n1, th.n2, th.hasNormal, normal, th.uv0, th.uv1, th.uv2, th.hasTexture, uv);
    normal = normalize(transpose(mat3(inst.worldToObject)) * normal);
    mat = materials[inst.materialOverride >= 0 ? inst.materialOverride : th.matIndex];
    return th;
}
bool debug_box(vec3 ray_origin, vec3 ray_dir, vec3 rayinv) {
    float min_t = 1e20;
    int min_index = -1;
    float tmin, tmax;
    for (int i = 0; i < tlas_size; ++i) {
        BVHNode n = tlas_node(i);
        if (intersectBox(ray_origin, ray_dir, rayinv, n.lmin, n.lmax, tmin, tmax) ||
            intersectBox(ray_origin, ray_dir, rayinv, n.rmin, n.rmax, tmin, tmax)) {
            return true;
        }
    }
    return false;
}
// Photon-merging estimate of the caustic radiance leaving x towards wo: photons within
// photonRadius (same side of the surface), f * flux / (N pi r^2). The radius shrinks over frames
// (progressive photon mapping), so the estimate is consistent.
vec3 gather_photons(vec3 x, vec3 n, vec3 wo, Material mat) {
    float r = photonRadius;
    vec3 g = x / (2.0 * r);
    ivec3 c0 = ivec3(floor(g));
    ivec3 dir = ivec3(step(vec3(0.5), fract(g))) * 2 - 1; // neighbour cells on the near side
    vec3 sum = vec3(0.0);
    for (int k = 0; k < 8; ++k) {
        ivec3 c = c0 + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1) * dir;
        uint i = photonBuf[2u + photon_cell(c)];
        for (int guard = 0; i != PHOTON_NONE && guard < 65536; ++guard) {
            uint b = 2u + photonGridSize + PHOTON_WORDS * i;
            vec3 p = uintBitsToFloat(uvec3(photonBuf[b], photonBuf[b + 1u], photonBuf[b + 2u]));
            vec3 d = p - x;
            if (dot(d, d) <= r * r) {
                vec3 pn = uintBitsToFloat(uvec3(photonBuf[b + 9u], photonBuf[b + 10u], photonBuf[b + 11u]));
                vec3 pw = uintBitsToFloat(uvec3(photonBuf[b + 6u], photonBuf[b + 7u], photonBuf[b + 8u]));
                if (dot(pn, n) > 0.5 && dot(pw, n) > 0.0) {
                    float pdfUnused;
                    vec3 power = uintBitsToFloat(uvec3(photonBuf[b + 3u], photonBuf[b + 4u], photonBuf[b + 5u]));
                    sum += opaque_eval(mat, n, wo, pw, pdfUnused) * power;
                }
            }
            i = photonBuf[b + 12u];
        }
    }
    return sum / (photonsEmitted * PI * r * r);
}

// Thread-group ID swizzling (NVIDIA, "Optimizing Compute Shaders for L2 Locality using
// Thread-Group ID Swizzling"): groups are launched in row-major order, so the groups in flight
// span whole rows of the screen. Remapping consecutive groups down vertical tiles `tileWidth`
// groups wide keeps the groups in flight on a compact patch, whose rays share BVH and
// triangle data in cache.
ivec2 pixelID() {
    uvec2 grid = gl_NumWorkGroups.xy, gid = gl_WorkGroupID.xy;
    uint n = uint(tileWidth);
    if (n > 0u && n < grid.x) {
        uint linear = gid.y * grid.x + gid.x;
        uint perTile = n * grid.y;
        uint tile = linear / perTile, inTile = linear % perTile;
        uint w = tile < grid.x / n ? n : grid.x % n; // the last tile may be narrower
        gid = uvec2(tile * n + inTile % w, inTile / w);
    }
    return ivec2(gid * gl_WorkGroupSize.xy + gl_LocalInvocationID.xy);
}

#ifdef LIGHT_TRACE
// ---------------------------------------------------------------------------------------
// Light tracing for caustics. A path leaves a light chosen by power; once it has passed
// through glass, every surface or fog vertex it reaches is connected to the pinhole camera
// and splatted into causticAccum. Paths whose first interaction is not glass belong to the
// camera tracer (which in turn skips light reached through glass after a scattering vertex).
// ---------------------------------------------------------------------------------------
void camera_frame(out vec3 fwd, out vec3 right, out vec3 up) {
    mat3 r = rotateY(angle_offset.x) * rotateX(angle_offset.y);
    fwd = r * vec3(0, 0, 1);
    right = r * vec3(1, 0, 0);
    up = r * vec3(0, 1, 0);
}

// Splats light scattered at x towards the camera. `scattered` is beta * f * |cos| at x (or
// beta * phase in fog); the pinhole importance and camera geometry are applied here. One light
// path is traced per pixel, so a pixel's per-frame estimate is simply the sum of its splats.
void connect_to_camera(vec3 x, vec3 so, vec3 scattered) {
    vec3 fwd, right, up;
    camera_frame(fwd, right, up);
    vec3 d = x - camera_pos;
    float z = dot(d, fwd);
    if (z <= 1e-6)
        return;
    float scale = tan(radians(fov) * 0.5);
    float aspect = iResolution.x / iResolution.y;
    float u = dot(d, right) / (z * scale);
    float v = dot(d, up) / (z * scale);
    ivec2 px = ivec2(floor(vec2((u / aspect * 0.5 + 0.5) * iResolution.x, (v * 0.5 + 0.5) * iResolution.y) + 0.5));
    if (px.x < 0 || px.y < 0 || px.x >= int(iResolution.x) || px.y >= int(iResolution.y))
        return;
    // Points near the camera would get huge 1/d^2 splats (fireflies); the camera tracer covers
    // caustic paths whose first scattering point is that close instead.
    if (dot(d, d) < ltMinDist * ltMinDist)
        return;
    vec3 sd = camera_pos - so;
    float sl = length(sd);
    sd /= sl;
    int tests = 0;
    if (find_closest(so, sd, 1.0 / sd, sl * (1.0 - 1e-4), true, tests).index != -1)
        return;
    float dist2 = dot(d, d);
    float cosCam = z / sqrt(dist2);
    float filmArea = 4.0 * aspect * scale * scale; // film at distance 1
    vec3 value = scattered * fog_transmittance(x, -d / sqrt(dist2), sqrt(dist2)) /
                 (dist2 * cosCam * cosCam * cosCam * filmArea);
    int ci = 3 * (px.y * int(iResolution.x) + px.x);
    for (int c = 0; c < 3; ++c) {
        float q = value[c] * CAUSTIC_SCALE;
        if (q > 0.0)
            atomicAdd(causticAccum[ci + c], uint(min(floor(q + random()), 4.0e9))); // stochastic rounding
    }
}

void light_trace_main() {
    ivec2 pix = pixelID();
    if (pix.x >= int(iResolution.x) || pix.y >= int(iResolution.y))
        return;
    initRandomGenerator(vec2(pix));
    seed ^= 0x68bc21ebu; // independent of the camera pass's stream
    if (emit_light_count == 0 || emitCdf[emit_light_count - 1] <= 0.0)
        return;

    // Emit: light by power, then a point and direction on it. beta = Le * cos / pdf.
    float u = random();
    int lo = 0, hi = emit_light_count - 1;
    while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (emitCdf[mid] < u) lo = mid + 1; else hi = mid;
    }
    float pmf = emitCdf[lo] - (lo > 0 ? emitCdf[lo - 1] : 0.0);
    if (pmf <= 0.0)
        return;
    Light L = lights[lo];
    vec3 o, d, beta;
    if (L.type == LIGHT_TRIANGLE) {
        vec3 p0, p1, p2;
        world_triangle(L.instance, L.tri, p0, p1, p2);
        float r1 = sqrt(random()), r2 = random();
        float b0 = 1.0 - r1, b1 = r1 * (1.0 - r2), b2 = r1 * r2;
        vec3 cr = cross(p1 - p0, p2 - p0);
        vec3 n = normalize(cr);
        if (random() < 0.5)
            n = -n; // two-sided
        Material m = materials[instance_material(L.instance, L.tri)];
        if (m.emissionMap >= 0) {
            Triangle th = triangle[L.tri];
            m.emission_color *= texture(textureHandles[m.emissionMap], b0 * th.uv0 + b1 * th.uv1 + b2 * th.uv2).rgb;
        }
        d = cosine_weighted_hemisphere(n);
        o = b0 * p0 + b1 * p1 + b2 * p2 + n * 1e-3;
        beta = get_emission(m) * (2.0 * PI * 0.5 * length(cr) / pmf); // area / (0.5 * 1/pi)
    } else if (L.type == LIGHT_SPHERE) {
        vec3 n = uniform_sphere_dir();
        d = cosine_weighted_hemisphere(n);
        o = L.posA.xyz + (L.posA.w + 1e-3) * n;
        beta = get_emission(materials[spheres[L.instance].matIndex]) * (4.0 * PI * PI * L.posA.w * L.posA.w / pmf);
    } else if (L.type == LIGHT_POINT) {
        o = L.posA.xyz;
        d = uniform_sphere_dir();
        beta = L.emit.rgb * emissionScale * (4.0 * PI / pmf);
    } else if (L.type == LIGHT_SPOT) {
        float cosT = 1.0 - random() * (1.0 - L.dirB.w);
        float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));
        float phi = 2.0 * PI * random();
        vec3 t, b;
        make_basis(L.dirB.xyz, t, b);
        d = normalize(t * (sinT * cos(phi)) + b * (sinT * sin(phi)) + L.dirB.xyz * cosT);
        o = L.posA.xyz;
        beta = L.emit.rgb * emissionScale * smoothstep(L.dirB.w, L.posA.w, cosT) * (2.0 * PI * (1.0 - L.dirB.w) / pmf);
    } else {
        return;
    }
    float beta0 = max(beta.r, max(beta.g, beta.b));
    if (beta0 <= 0.0)
        return;

    bool throughGlass = false;
    bool photonStored = false; // a photon is stored at the first diffuse vertex after glass
    bool insideGlass = false;
    vec3 mediumSigma = vec3(0.0);
    float lambda = 0.0; // sampled wavelength once dispersive glass is met
    for (int seg = 0; seg < 24; ++seg) {
        int tests = 0;
        HitInfo hi = find_closest(o, d, 1.0 / d, 1e30, false, tests);
        if (fogEnabled != 0 && !insideGlass) {
            float t0, t1;
            if (fog_overlap(o, d, hi.index == -1 ? 1e30 : hi.t, t0, t1)) {
                vec3 sigmaT = fogSigmaS + fogSigmaA;
                float st = sigmaT[min(int(random() * 3.0), 2)];
                float dd = st > 0.0 ? t0 - log(1.0 - random()) / st : 1e30;
                if (dd < t1) {
                    vec3 Tr = exp(-sigmaT * (dd - t0));
                    beta *= fogSigmaS * Tr / dot(sigmaT * Tr, vec3(1.0 / 3.0));
                    vec3 p = o + d * dd;
                    if (!throughGlass && ltDebugDirect == 0)
                        return; // light -> fog: the camera tracer's job
                    connect_to_camera(p, p, beta * hg_phase(dot(d, normalize(camera_pos - p)), fogG));
                    d = sample_hg(d, fogG);
                    o = p;
                    float q = clamp(max(beta.r, max(beta.g, beta.b)) / beta0, 0.05, 1.0);
                    if (random() >= q)
                        return;
                    beta /= q;
                    continue;
                }
                vec3 Tr = exp(-sigmaT * (t1 - t0));
                beta *= Tr / dot(Tr, vec3(1.0 / 3.0));
            }
        }
        if (max(mediumSigma.r, max(mediumSigma.g, mediumSigma.b)) > 0.0)
            beta *= exp(-mediumSigma * (hi.index == -1 ? 1e30 : hi.t));
        if (hi.index == -1)
            return;

        vec3 x = o + d * hi.t;
        Material mat;
        vec3 n;
        bool frontFace = true;
        if (hi.is_sphere) {
            Sphere sh = spheres[hi.index];
            mat = materials[sh.matIndex];
            n = normalize(x - sh.center);
            frontFace = dot(n, d) < 0.0;
            if (!frontFace)
                n = -n;
        } else {
            vec2 uv;
            Triangle th = hit_surface(hi, o, d, mat, n, uv, frontFace);
            if (th.hasTexture)
                mat.albedo = texture(textureHandles[th.colourMapIndex], uv).rgb;
        }
        vec3 em = get_emission(mat);
        if (max(em.r, max(em.g, em.b)) > 0.0)
            return; // emitters end paths, as in the camera tracer
        vec3 wo = -d; // towards where the light came from; n faces it

        if (mat.transmission > 0.0 && random() < mat.transmission) {
            bool thin = mat.thinWalled != 0;
            if (mat.dispersion > 0.0 && lambda == 0.0) {
                vec3 w;
                lambda = sample_wavelength(w);
                beta *= w;
            }
            float ior = dispersive_ior(mat.eta, mat.dispersion, lambda);
            float etaRatio = (thin || frontFace) ? 1.0 / ior : ior;
            bool rough = mat.roughness > 0.02 && !thin;
            float a2 = ggx_alpha(mat.roughness) * ggx_alpha(mat.roughness);
            vec3 m = rough ? sample_ggx_vndf(n, wo, ggx_alpha(mat.roughness)) : n;
            float cosI = clamp(dot(wo, m), 0.0, 1.0);
            vec3 wi;
            if (random() < fresnel_dielectric(cosI, etaRatio)) {
                wi = reflect(-wo, m);
                if (dot(wi, n) <= 0.0)
                    return;
                o = x + n * 1e-3;
            } else {
                wi = thin ? -wo : refract(-wo, m, etaRatio);
                if (dot(wi, n) >= 0.0)
                    return;
                o = x - n * 1e-3;
                beta *= mat.albedo;
                if (!thin) {
                    mediumSigma = frontFace ? mat.sigma_a : vec3(0.0);
                    insideGlass = frontFace;
                }
            }
            if (rough)
                beta *= smith_G1(abs(dot(wi, n)), a2);
            d = wi;
            throughGlass = true;
            continue;
        }

        if (!throughGlass && ltDebugDirect == 0)
            return; // light -> surface: the camera tracer's job
        // First diffuse vertex after glass: store a photon (incident flux beta from direction wo)
        // for camera paths that reach this surface through glass (photon merging).
        if (usePhotonMerging != 0 && !photonStored) {
            photonStored = true;
            uint idx = atomicAdd(photonBuf[0], 1u);
            if (idx < photonCapacity) {
                uint b = 2u + photonGridSize + PHOTON_WORDS * idx;
                photonBuf[b] = floatBitsToUint(x.x); photonBuf[b + 1u] = floatBitsToUint(x.y); photonBuf[b + 2u] = floatBitsToUint(x.z);
                photonBuf[b + 3u] = floatBitsToUint(beta.r); photonBuf[b + 4u] = floatBitsToUint(beta.g); photonBuf[b + 5u] = floatBitsToUint(beta.b);
                photonBuf[b + 6u] = floatBitsToUint(wo.x); photonBuf[b + 7u] = floatBitsToUint(wo.y); photonBuf[b + 8u] = floatBitsToUint(wo.z);
                photonBuf[b + 9u] = floatBitsToUint(n.x); photonBuf[b + 10u] = floatBitsToUint(n.y); photonBuf[b + 11u] = floatBitsToUint(n.z);
                uint h = photon_cell(ivec3(floor(x / (2.0 * photonRadius))));
                photonBuf[b + 12u] = atomicExchange(photonBuf[2u + h], idx);
            }
        }
        // Connect to the camera (reciprocal BRDF: camera and light side must both face n).
        vec3 wc = normalize(camera_pos - x);
        float pdfUnused;
        vec3 f = opaque_eval(mat, n, wc, wo, pdfUnused);
        if (max(f.r, max(f.g, f.b)) > 0.0)
            connect_to_camera(x, x + n * 1e-3, beta * f * abs(dot(n, wc)));
        if (ltDebugDirect != 0)
            return;
        // Continue the light path.
        vec3 wi;
        if (!opaque_sample(mat, n, wo, wi))
            return;
        float pdf;
        vec3 ff = opaque_eval(mat, n, wo, wi, pdf);
        if (pdf <= 0.0)
            return;
        beta *= ff * dot(n, wi) / pdf;
        o = x + n * 1e-3;
        d = wi;
        float q = clamp(max(beta.r, max(beta.g, beta.b)) / beta0, 0.05, 1.0);
        if (random() >= q)
            return;
        beta /= q;
    }
}

void main() {
    light_trace_main();
}
#else
