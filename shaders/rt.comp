        int i = 0;
        vec3 mediumSigma = vec3(0.0); // absorption of the volume the ray is travelling through
        bool insideGlass = false;
        bool hadScatter = false;      // a non-specular vertex (surface or fog) occurred
        bool specChain = false;       // only glass events since the last such vertex
        bool firstScatterDirect = false;
        bool firstScatterMerged = false; // caustics at the first scatter came from photon merging
        int scatterCount = 0;
        bool specSeen = false; // any glass event so far
        float lambda = 0.0;    // sampled wavelength (nm), 0 until the path meets dispersive glass // the first scattering vertex is seen without glass (light tracing can connect to it)
        bool prevEquiangular = false; // the previous segment's direct light came from equiangular sampling
        bool done = false;
        // Shadow rays queued during an iteration are traced at the top of the next one, so the
        // shadow traversal is inlined once.
        vec3 shO[2], shD[2], shVal[2];
        float shMax[2];
        int shCount = 0;
        int seg = 0;
        for (;;) {
            for (int k = 0; k < shCount; ++k) {
                int shadowTests = 0;
                if (find_closest(shO[k], shD[k], 1.0 / shD[k], shMax[k], true, shadowTests).index == -1)
                    light += shVal[k];
            }
            shCount = 0;
            if (done || seg >= bounces + 16 || i >= bounces)
                break;
            ++seg;
            int intersects = 0;
            HitInfo hi = find_closest(ray_origin, ray_dir, rayinv, 1e30, false, intersects);
            // Fog: sample a free-flight distance within the segment's overlap with the fog box.
            // One colour channel drives the sampling; weights use the channel-averaged pdf, so
            // coloured media stay unbiased. Not inside glass (the medium is outside objects).
            if (fogEnabled != 0 && !insideGlass) {
                float segLen = length(ray_dir);
                vec3 dir = ray_dir / segLen;
                float t0, t1;
                if (fog_overlap(ray_origin, dir, hi.index == -1 ? 1e30 : hi.t * segLen, t0, t1)) {
                    vec3 sigmaT = fogSigmaS + fogSigmaA;
                    // Direct in-scattering along this segment via equiangular sampling; the free-
                    // flight vertex below then skips direct light so nothing is counted twice.
                    bool segEquiangular = useEquiangular != 0 && useNEE != 0 && light_count > 0 && i < neeDepth;
                    if (segEquiangular && equiangular_direct(ray_origin, dir, t0, t1, contribution, shO[shCount], shD[shCount], shMax[shCount], shVal[shCount]))
                        ++shCount;
                    float st = sigmaT[min(int(random() * 3.0), 2)];
                    float d = st > 0.0 ? t0 - log(1.0 - random()) / st : 1e30;
                    if (d < t1) {
                        // Scattering event: weight sigma_s * Tr / pdf.
                        vec3 Tr = exp(-sigmaT * (d - t0));
                        contribution *= fogSigmaS * Tr / dot(sigmaT * Tr, vec3(1.0 / 3.0));
                        vec3 p = ray_origin + dir * d;
                        // Below neeDepth only delta lights are light-sampled: BSDF rays can't hit them,
                        // while area lights are left to (full-weight) phase sampling.
                        bool neeVertex = useNEE != 0 && light_count > 0 && i < neeDepth && !segEquiangular;
                        bool deltaOnly = !neeVertex && !segEquiangular && useNEE != 0 && delta_light_count > 0;
                        if (neeVertex || deltaOnly) {
                            vec3 wl, Li;
                            float dist, pdfLight;
                            bool isDelta = true;
                            bool sampled = neeVertex ? sample_light(p, vec3(0.0), wl, dist, Li, pdfLight, isDelta)
                                                     : sample_delta_light(p, wl, dist, Li, pdfLight);
                            if (sampled && pdfLight > 0.0) {
                                float ph = hg_phase(dot(dir, wl), fogG);
                                float w = (isDelta || i == bounces - 1) ? 1.0 : pdfLight * pdfLight / (pdfLight * pdfLight + ph * ph);
                                shO[shCount] = p;
                                shD[shCount] = wl;
                                shMax[shCount] = dist * (1.0 - 1e-3);
                                shVal[shCount] = contribution * ph * Li * fog_transmittance(p, wl, dist) / pdfLight * w;
                                ++shCount;
                            }
                        }
                        if (!hadScatter)
                            firstScatterDirect = !specSeen && distance(p, camera_pos) >= ltMinDist;
                        hadScatter = true;
                        ++scatterCount;
                        specChain = false;
                        prevEquiangular = segEquiangular;
                        vec3 wi = sample_hg(dir, fogG); // pdf == phase, so the throughput is unchanged
                        prevDiffuse = neeVertex;
                        prevPoint = p;
                        prevNormal = vec3(0.0);
                        prevBsdfPdf = hg_phase(dot(dir, wi), fogG);
                        ray_origin = p;
                        ray_dir = wi;
                        rayinv = 1.0 / wi;
                        if (rrStart >= 0 && i >= rrStart && i < bounces - 1) {
                            float q = clamp(max(contribution.r, max(contribution.g, contribution.b)), 0.05, 1.0);
                            if (random() >= q)
                                { done = true; continue; }
                            contribution /= q;
                        }
                        ++i;
                        continue;
                    }
                    // Passed through: weight Tr / P(no event).
                    vec3 Tr = exp(-sigmaT * (t1 - t0));
                    contribution *= Tr / dot(Tr, vec3(1.0 / 3.0));
                }
            }
            // Beer-Lambert absorption along the segment inside a volume.
            if (max(mediumSigma.r, max(mediumSigma.g, mediumSigma.b)) > 0.0)
                contribution *= exp(-mediumSigma * (hi.index == -1 ? 1e30 : hi.t * length(ray_dir)));
            if (debugView == 1) {
                // Box + triangle tests for the primary ray: blue (cheap) -> green -> red (>= 512).
                float h = clamp(float(intersects) / 512.0, 0.0, 1.0);
                light = h < 0.5 ? mix(vec3(0, 0, 1), vec3(0, 1, 0), h * 2.0) : mix(vec3(0, 1, 0), vec3(1, 0, 0), h * 2.0 - 1.0);
                { done = true; continue; }
            }
            float t1 = hi.t;
            if (hi.index == -1) {
                vec2 skybox_uv = RayDirectionToUV(ray_dir);
                vec3 sky_box = texture(hdri, skybox_uv).rgb;
                sky_box = clamp(sky_box, 0.0f, 10.0f);
                sky_box = (vec3(0,0,0) + sky_box);
                light += sky_box * contribution;
                // Sized suns are hit by escaping rays (MIS against light sampling). Light tracing
                // never emits directional lights, so these paths are always the camera's.
                for (int k = 0; k < infinite_light_count; ++k) {
                    Light L = lights[k];
                    if (L.dirB.w <= 0.0 || dot(ray_dir, -L.dirB.xyz) < L.dirB.w)
                        continue;
                    float w = prevEquiangular ? 0.0 : 1.0;
                    if (prevDiffuse && !prevEquiangular) {
                        float pdfLight = light_pmf(prevPoint, prevNormal, k) * sun_cone_pdf(L);
                        w = prevBsdfPdf * prevBsdfPdf / (prevBsdfPdf * prevBsdfPdf + pdfLight * pdfLight);
                    }
                    light += sun_radiance(L) * contribution * w;
                }
                { done = true; continue; }
            }
            vec3 hit_point = vec3(0.0f);
            Material mat;
            vec3 normal;
            bool frontFace = true;
            if (hi.is_sphere) {
                Sphere sh = spheres[hi.index];
                mat = materials[sh.matIndex];
                hit_point = ray_origin + ray_dir * t1;
                normal = normalize(hit_point - sh.center);
                frontFace = dot(normal, ray_dir) < 0.0;
                if (!frontFace)
                    normal = -normal;
            } else {
                vec2 interpolatedUv;
                Triangle th = hit_surface(hi, ray_origin, ray_dir, mat, normal, interpolatedUv, frontFace);
                hit_point = ray_origin + ray_dir * t1;
                if (th.hasTexture) {
                    vec3 texColor = texture(textureHandles[th.colourMapIndex], interpolatedUv).rgb;
                    mat.albedo = texColor;
                }
                if (mat.emissionMap >= 0) {
                    mat.emission_color *= texture(textureHandles[mat.emissionMap], interpolatedUv).rgb;
                }
            }
            // Smooth dielectric (glTF transmission), chosen with probability `transmission`.
            // Reflect with the exact Fresnel probability (untinted), otherwise refract, tinted by
            // the base color; refraction into a volume starts Beer-Lambert absorption.
            // Rough glass scatters about a GGX microfacet normal (VNDF-sampled); the estimator
            // weight is then G1 of the outgoing direction (Fresnel cancels its selection).
            if (mat.transmission > 0.0 && random() < mat.transmission) {
                vec3 wo = -normalize(ray_dir); // towards the previous vertex; normal faces it
                bool thin = mat.thinWalled != 0;
                if (mat.dispersion > 0.0 && lambda == 0.0) {
                    vec3 w;
                    lambda = sample_wavelength(w);
                    contribution *= w;
                }
                float ior = dispersive_ior(mat.eta, mat.dispersion, lambda);
                float etaRatio = (thin || frontFace) ? 1.0 / ior : ior;
                bool rough = mat.roughness > 0.02 && !thin;
                float a2 = ggx_alpha(mat.roughness) * ggx_alpha(mat.roughness);
                vec3 m = rough ? sample_ggx_vndf(normal, wo, ggx_alpha(mat.roughness)) : normal;
                float cosI = clamp(dot(wo, m), 0.0, 1.0);
                vec3 wi;
                bool transmitted = random() >= fresnel_dielectric(cosI, etaRatio);
                if (!transmitted) {
                    wi = reflect(-wo, m);
                    if (dot(wi, normal) <= 0.0)
                        { done = true; continue; } // reflected below the surface: absorbed by masking
                    ray_origin = hit_point + normal * 0.001;
                } else {
                    wi = thin ? -wo : refract(-wo, m, etaRatio);
                    if (dot(wi, normal) >= 0.0)
                        { done = true; continue; }
                    ray_origin = hit_point - normal * 0.001;
                    // Radiance is compressed by (eta_i / eta_t)^2 across a refraction (it cancels
                    // over a closed object); light tracing transports importance and has no factor.
                    contribution *= mat.albedo * (thin ? 1.0 : etaRatio * etaRatio);
                    if (!thin) {
                        mediumSigma = frontFace ? mat.sigma_a : vec3(0.0);
                        insideGlass = frontFace;
                    }
                }
                if (rough)
                    contribution *= smith_G1(abs(dot(wi, normal)), a2);
                ray_dir = wi;
                rayinv = 1.0 / ray_dir;
                prevDiffuse = false;
                prevEquiangular = false;
                specChain = true;
                specSeen = true;
                continue; // specular events don't use the bounce budget
            }
            vec3 wo = -normalize(ray_dir); // towards the previous vertex; normal faces it
            ray_origin = hit_point + normal * 0.01;
            // Emitted light reaches the eye with the throughput accumulated so far.
            vec3 emission = get_emission(mat);
            // Stop ray at emitters (unlit texels of an emissive map still reflect)
            if (max(emission.r, max(emission.g, emission.b)) > 0.0) {
                // Light reached through glass right after a scattering vertex is a caustic path:
                // light tracing estimates it instead.
                if (useCausticTracing != 0 && hadScatter && specChain && firstScatterDirect) { done = true; continue; } // (firstScatterDirect includes the ltMinDist test)
                // ... and light reached through glass right after a merged first vertex was
                // estimated from the photons there.
                if (useCausticTracing != 0 && specChain && firstScatterMerged && scatterCount == 1) { done = true; continue; }
                float w = prevEquiangular ? 0.0 : 1.0; // already estimated by equiangular sampling
                if (prevDiffuse && !prevEquiangular) {
                    // Light sampling could also have produced this path: power-heuristic weight.
                    float pdfLight = 0.0;
                    if (!hi.is_sphere) {
                        Instance inst = instances[hi.instance];
                        int li = inst.lightIndexBase >= 0 ? lightIndexOf[inst.lightIndexBase + hi.index - inst.triStart] : -1;
                        if (li >= 0) {
                            vec3 p0, p1, p2;
                            world_triangle(hi.instance, hi.index, p0, p1, p2);
                            vec3 cr = cross(p1 - p0, p2 - p0);
                            float area = 0.5 * length(cr);
                            vec3 d = hit_point - prevPoint;
                            float dist2 = dot(d, d);
                            float cosL = abs(dot(cr / (2.0 * area), d * inversesqrt(dist2)));
                            pdfLight = light_pmf(prevPoint, prevNormal, li) / area * dist2 / max(cosL, 1e-8);
                        }
                    } else if (spheres[hi.index].lightIndex >= 0) {
                        Sphere sh = spheres[hi.index];
                        pdfLight = light_pmf(prevPoint, prevNormal, sh.lightIndex) * sphere_cone_pdf(prevPoint, sh.center, sh.r);
                    }
                    w = prevBsdfPdf * prevBsdfPdf / (prevBsdfPdf * prevBsdfPdf + pdfLight * pdfLight);
                }
                light += emission * contribution * w;
                { done = true; continue; }
            }

            if (!hadScatter) {
                firstScatterDirect = !specSeen && distance(hit_point, camera_pos) >= ltMinDist;
                // Light tracing cannot connect to this vertex (seen through glass, or too close):
                // estimate its caustic light (light -> glass -> here) from the stored photons.
                if (useCausticTracing != 0 && usePhotonMerging != 0 && !firstScatterDirect) {
                    light += contribution * gather_photons(hit_point, normal, wo, mat);
                    firstScatterMerged = true;
                }
            }
            hadScatter = true;
            ++scatterCount;
            specChain = false;
            prevEquiangular = false;
            // Light sampling (NEE) with the full BRDF; deeper vertices skip it (BSDF sampling
            // only), and MIS below only applies to vertices that actually sampled a light.
            // Below neeDepth only delta lights are light-sampled: BSDF rays can't hit them, while
            // area lights are left to (full-weight) BSDF sampling.
            bool neeVertex = useNEE != 0 && light_count > 0 && i < neeDepth;
            bool deltaOnly = !neeVertex && useNEE != 0 && delta_light_count > 0;
            if (neeVertex || deltaOnly) {
                vec3 wi, Li;
                float dist, pdfLight;
                bool isDelta = true;
                // Sample from the true surface point; only the shadow ray starts at the offset origin.
                bool sampled = neeVertex ? sample_light(hit_point, normal, wi, dist, Li, pdfLight, isDelta)
                                         : sample_delta_light(hit_point, wi, dist, Li, pdfLight);
                if (sampled) {
                    float pdfBsdf;
                    vec3 f = opaque_eval(mat, normal, wo, wi, pdfBsdf);
                    if (max(f.r, max(f.g, f.b)) > 0.0 && pdfLight > 0.0) {
                        // Shadow ray from the offset origin to exactly the sampled light point.
                        vec3 shadowDir = wi;
                        float shadowMax = dist;
                        if (dist < 1e29) {
                            vec3 toLight = hit_point + wi * dist - ray_origin;
                            shadowMax = length(toLight);
                            shadowDir = toLight / shadowMax;
                        }
                        // Delta lights can't be hit by BSDF rays; the last vertex has no BSDF
                        // continuation. Both take full weight, otherwise power heuristic.
                        float w = (isDelta || i == bounces - 1) ? 1.0 : pdfLight * pdfLight / (pdfLight * pdfLight + pdfBsdf * pdfBsdf);
                        shO[shCount] = ray_origin;
                        shD[shCount] = shadowDir;
                        shMax[shCount] = shadowMax * (1.0 - 1e-3);
                        shVal[shCount] = contribution * f * dot(normal, wi) * Li * fog_transmittance(ray_origin, shadowDir, shadowMax) / pdfLight * w;
                        ++shCount;
                    }
                }
            }

            // Continue the path by sampling the BRDF.
            vec3 wi;
            if (!opaque_sample(mat, normal, wo, wi))
                { done = true; continue; }
            float pdfBsdf;
            vec3 f = opaque_eval(mat, normal, wo, wi, pdfBsdf);
            if (pdfBsdf <= 0.0)
                { done = true; continue; }
            contribution *= f * dot(normal, wi) / pdfBsdf;
            ray_dir = wi;
            rayinv = 1.0 / ray_dir;
            prevDiffuse = neeVertex;
            prevPoint = hit_point;
            prevNormal = normal;
            prevBsdfPdf = pdfBsdf;
            // Russian roulette: continue with probability p (by throughput) and divide
            // survivors by p. Unbiased; skipped at the last vertex (nothing left to trace).
            if (rrStart >= 0 && i >= rrStart && i < bounces - 1) {
                float p = clamp(max(contribution.r, max(contribution.g, contribution.b)), 0.05, 1.0);
                if (random() >= p)
                    { done = true; continue; }
                contribution /= p;
            }
            ++i;
        }
        fcolor += light / float(samples);
    }

    // Add this frame's light-traced caustic splats for the pixel and clear them.
    if (useCausticTracing != 0) {
        int ci = 3 * (pix.y * int(iResolution.x) + pix.x);
        fcolor += vec3(causticAccum[ci], causticAccum[ci + 1], causticAccum[ci + 2]) / CAUSTIC_SCALE;
        causticAccum[ci] = 0u;
        causticAccum[ci + 1] = 0u;
        causticAccum[ci + 2] = 0u;
    }
    vec4 outColor = vec4(fcolor, 1.0);
    vec2 uv1 = coords.xy / iResolution.xy;
    vec4 prevCol = adaptive != 0 ? imageLoad(outputImage, pix) : imageLoad(prevFrame, pix);
    if (iTime > 1.0f) {
        if (iFrame == 1)
            prevCol = vec4(0.0);
        vec4 sum = outColor + prevCol;
        imageStore(outputImage, pix, sum);
        if (adaptive != 0) {
            // Cycles' convergence test: compare the mean of all samples (I) with the mean of the
            // odd-indexed ones (A, from the half buffer), relative to sqrt(intensity).
            vec4 aux = imageLoad(adaptiveAux, pix);
            if (int(prevCol.a) % 2 == 1)
                aux.rgb += 2.0 * outColor.rgb;
            float n = sum.a;
            // aux.a: -1 converged, else the last noise estimate / threshold (0: none yet).
            float state = aux.a;
            bool converged = n >= float(adaptiveMaxSpp); // sample cap
            if (!converged && n >= float(adaptiveMinSpp) && int(n) % 2 == 0) {
                vec3 I = sum.rgb / n, A = aux.rgb / n;
                float err = (abs(I.r - A.r) + abs(I.g - A.g) + abs(I.b - A.b)) / (1e-4 + sqrt(I.r + I.g + I.b));
                converged = err < noiseThreshold;
                state = err / noiseThreshold;
            }
            aux.a = converged ? -1.0 : state;
            imageStore(adaptiveAux, pix, aux);
            if (!converged)
                atomicAdd(photonBuf[1], 1u);
        }
    }
    #endif
}
#endif // LIGHT_TRACE
